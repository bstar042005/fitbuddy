# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Secret used to sign login tokens. CHANGE THIS for any shared deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Shared key that lets scripts/devices post reps without a user login
# (used by `npm run simulate` and curl examples). Leave empty to disable.
DEVICE_API_KEY="dev-device-key"

# Optional: enables AI parsing of meals the rule-based parser doesn't know
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-4-5-20251001"
